# mini-movie-maker 环境配置模板
# 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）

# OpenAI 兼容 LLM 网关（opencode zen）
# 用于阶段5 解说稿生成（deepseek-v4-flash）与阶段3 视觉理解（mimo-v2.5）
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_ZEN_API_KEY=your-api-key-here

# 可选：LLM 调用限速（秒），默认 0.5
# MMM_LLM_INTERVAL=0.5

# 模型选择（可调整，改这里即可）
# 解说模型（阶段5）
MMM_NARRATE_MODEL=deepseek-v4-flash
# 视觉模型（阶段3）
MMM_VISION_MODEL=mimo-v2.5
